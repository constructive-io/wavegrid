# electron-forge's preflight shells out to `pnpm config get hoist-pattern` and
# refuses to start when it and `public-hoist-pattern` are both unset. It runs in
# this package's directory, and some pnpm versions (notably on Windows) read only
# the .npmrc next to the cwd, not the workspace root's — so the root setting is
# repeated here to keep `pnpm start` working from inside packages/desktop.
#
# `*` is pnpm's own default pattern, so the install layout is unchanged.
hoist-pattern[]=*
