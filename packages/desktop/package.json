{
  "name": "@wavegrid/desktop",
  "version": "0.1.0",
  "author": "Dan Lynch <pyramation@gmail.com>",
  "description": "Wavegrid Desktop — a thin Electron shell around the one-brain runtime, with a Constructive Blocks admin UI wrapping the untouched laser UI",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": ".vite/build/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/wavegrid"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf .vite out",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx --fix",
    "test": "jest --passWithNoTests"
  },
  "keywords": [
    "wavegrid",
    "electron",
    "laser",
    "constructive-blocks"
  ],
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@wavegrid/discovery": "workspace:*",
    "@wavegrid/doctor": "workspace:*",
    "@wavegrid/layout": "workspace:*",
    "@wavegrid/receiver": "workspace:*",
    "@wavegrid/server": "workspace:*",
    "@wavegrid/settings": "workspace:*",
    "@wavegrid/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.469.0",
    "motion": "^13.0.0",
    "qrcode": "1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.1.10",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
